      <aliases enabled='yes' />
      <column caption='Zero Automobile Household' datatype='boolean' name='[Calculation_6865667278683148291]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='([hhNumAutos]==0)' />
        <aliases>
          <alias key='false' value='One or more car Household' />
          <alias key='true' value='Zero car Household' />
        </aliases>
      </column>
      <column caption='Simple Mode' datatype='string' name='[Calculation_6865667278683529220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [mode]&#10;when 1 then &quot;Single occupant Automobile&quot;&#10;when 2 then &quot;Multiple occupant Automobile&quot;&#10;when 3 then &quot;Multiple occupant Automobile&quot;&#10;when 4 then &quot;Multiple occupant Automobile&quot;&#10;when 5 then &quot;Transit&quot;&#10;when 6 then &quot;Transit&quot;&#10;when 7 then &quot;Transit&quot;&#10;when 8 then &quot;Transit&quot;&#10;when 9 then &quot;Transit&quot;&#10;when 10 then &quot;Transit&quot;&#10;when 11 then &quot;Walk&quot;&#10;when 12 then &quot;Bicycle&quot;&#10;when 13 then &quot;Taxi&quot;&#10;when 14 then &quot;School bus&quot;&#10;ELSE&#10;&quot;No travel&quot;&#10;END' />
      </column>
      <column caption='Simple Purpose' datatype='string' name='[Calculation_6865667279814623239]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [tourPrimaryDestPurp]&#10;when 1 then &quot;Work?&quot;&#10;when 2 then &quot;University?&quot;&#10;when 3 then &quot;School&quot;&#10;when 411 then &quot;Escort&quot;&#10;when 42 then &quot;Escort&quot;&#10;when 5 then &quot;Shopping&quot;&#10;when 6 then &quot;Maintenance&quot;&#10;when 71 then &quot;Eating out&quot;&#10;when 72 then &quot;Eating out&quot;&#10;when 73 then &quot;Eating out&quot;&#10;when 8 then &quot;Visiting&quot;&#10;when 9 then &quot;Unknown&quot;&#10;else &quot;MISSING&quot;&#10;END' />
      </column>
